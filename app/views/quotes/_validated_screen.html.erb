<div class="card">
  <%= link_to quotes_path, class: "button quote-page__back" do %>
    <%= back_button_content(t("quotes.quote_screen.exit")) %>
  <% end %>
  <div class="quote-header">
    <h1 class="quote-header__name"><%= quote.name %></h1>
    <span class="badge badge--validated"><%= t("quotes.quote_screen.validated_badge") %></span>
  </div>

  <% if flash[:alert] %>
    <ul class="inline-form__errors">
      <li><%= flash[:alert] %></li>
    </ul>
  <% end %>

  <%= render "items_table", quote: quote, totals: totals %>
  <%= render "totals", totals: totals %>
</div>

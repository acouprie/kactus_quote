<tr id="<%= dom_id(quote) %>">
  <td><%= quote.id %></td>
  <td><%= l(quote.created_at.to_date) %></td>
  <td><%= quote.name %></td>
  <td>
    <% if quote.draft? %>
      <%= link_to quote_path(quote), aria: { label: t("quotes.edit") } do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20h9" />
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" />
        </svg>
      <% end %>
      <%= button_to quote_path(quote),
            method: :delete,
            data: { turbo_confirm: t("quotes.destroy_confirm") },
            aria: { label: t("quotes.destroy") } do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h18" />
          <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
        </svg>
      <% end %>
    <% else %>
      <%= link_to quote_path(quote), aria: { label: t("quotes.show") } do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
      <% end %>
    <% end %>
  </td>
</tr>

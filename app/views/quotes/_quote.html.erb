<tr id="<%= dom_id(quote) %>">
  <td><%= quote.id %></td>
  <td><%= l(quote.created_at.to_date) %></td>
  <td class="quotes-table__name"><%= quote.name %></td>
  <td class="quotes-table__actions">
    <% if quote.draft? %>
      <%= link_to quote_path(quote), class: "icon-button", aria: { label: t("quotes.edit") } do %>
        <%= pencil_icon %>
      <% end %>
      <%= button_to quote_path(quote),
            method: :delete,
            class: "icon-button icon-button--danger",
            form_class: "icon-button__form",
            data: { turbo_confirm: t("quotes.destroy_confirm") },
            aria: { label: t("quotes.destroy") } do %>
        <%= trash_icon %>
      <% end %>
    <% else %>
      <%= link_to quote_path(quote), class: "icon-button", aria: { label: t("quotes.show") } do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
      <% end %>
    <% end %>
  </td>
</tr>

<%= form_with model: item,
      url: item.new_record? ? quote_items_path(quote) : quote_item_path(quote, item),
      class: "items-row items-row--form",
      data: { controller: "item-form" } do |form| %>
  <% if item.errors.any? %>
    <ul class="inline-form__errors">
      <% item.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="items-row__cell items-row__cell--name">
    <%= form.text_field :name,
          class: "input",
          placeholder: t("quotes.items.form.name_placeholder"),
          autofocus: true,
          data: { item_form_target: "name", action: "keydown.esc->inline-form#cancel" } %>
  </div>
  <div class="items-row__cell items-row__cell--quantity">
    <%= form.text_field :quantity,
          class: "input",
          placeholder: t("quotes.items.form.quantity_placeholder"),
          data: { item_form_target: "quantity", action: "input->item-form#compute keydown.esc->inline-form#cancel" } %>
  </div>
  <div class="items-row__cell items-row__cell--unit-price">
    <%= form.text_field :unit_price_excl_vat,
          class: "input",
          placeholder: t("quotes.items.form.unit_price_placeholder"),
          data: { item_form_target: "unitPrice", action: "input->item-form#compute keydown.esc->inline-form#cancel" } %>
  </div>
  <div class="items-row__cell items-row__cell--vat">
    <%= form.select :vat_rate,
          QuoteItem::ALLOWED_VAT_RATES.map { |rate| [ number_to_percentage(rate), rate.to_s("F") ] },
          { selected: item.vat_rate&.to_s("F") },
          class: "input",
          data: { action: "keydown.esc->inline-form#cancel" } %>
  </div>
  <div class="items-row__cell items-row__cell--net-preview">
    <span data-item-form-target="netPreview">—</span>
  </div>
  <div class="items-row__cell items-row__cell--gross-preview">—</div>
  <div class="items-row__cell items-row__cell--actions">
    <%= form.button type: "submit", class: "icon-button", aria: { label: t("quotes.items.form.submit") } do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5" />
      </svg>
    <% end %>
    <% if local_assigns[:show_cancel] %>
      <button type="button" class="icon-button" data-action="click->inline-form#cancel" aria-label="<%= t("quotes.items.form.cancel") %>">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    <% end %>
  </div>
<% end %>

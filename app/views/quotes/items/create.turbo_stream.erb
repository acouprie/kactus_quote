<% if @item.persisted? %>
  <%# The whole table body is re-rendered rather than the new row appended: a new line can move
      a cent of its rate group's VAT onto another line, so a row already on screen may now
      display a different Total TTC. See docs/logbook.md, "The VAT computation contract". %>
  <%= turbo_stream.update "quote_items" do %>
    <%= render "quotes/items/rows", lines: @totals.lines %>
  <% end %>

  <%= turbo_stream.replace "new_item" do %>
    <%= render "quotes/items/new_item_frame", quote: @quote, item: @quote.quote_items.new %>
  <% end %>

  <%= turbo_stream.replace "quote_totals" do %>
    <%= render "quotes/totals", totals: @totals %>
  <% end %>

  <%= turbo_stream.replace "quote_validate_button" do %>
    <%= render "quotes/validate_button", quote: @quote %>
  <% end %>
<% else %>
  <%= turbo_stream.replace "new_item" do %>
    <%= render "quotes/items/new_item_frame", quote: @quote, item: @item %>
  <% end %>
<% end %>

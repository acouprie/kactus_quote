<% if @item.errors.empty? %>
  <%= turbo_stream.replace dom_id(@item, :frame) do %>
    <%= render "quotes/items/item_display_frame", item: @item, line: @totals.lines.find { |line| line.item == @item } %>
  <% end %>

  <%= turbo_stream.replace "quote_totals" do %>
    <%= render "quotes/totals", totals: @totals %>
  <% end %>
<% else %>
  <%= turbo_stream.replace dom_id(@item, :frame) do %>
    <%= render "quotes/items/item_edit_frame", quote: @quote, item: @item %>
  <% end %>
<% end %>

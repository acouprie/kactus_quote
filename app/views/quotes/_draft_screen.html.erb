<div class="card">
  <%= form_with model: quote, method: :patch, class: "quote-page" do |form| %>
    <%= form.button class: "button quote-page__back" do %>
      <%= back_button_content(t("quotes.quote_screen.save_and_exit")) %>
    <% end %>
    <div class="quote-header">
      <%= form.text_field :name, class: "quote-header__name-input" %>
      <span class="badge badge--draft"><%= t("quotes.quote_screen.draft_badge") %></span>
    </div>

    <% if quote.errors.any? %>
      <ul class="inline-form__errors">
        <% quote.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <%= render "flash", quote: quote %>
  <%= render "items_table", quote: quote, totals: totals %>
  <%= render "totals", totals: totals %>

  <%= render "validate_button", quote: quote %>
</div>

<%= form_with model: quote, data: { turbo_frame: "_top" } do |form| %>
  <% if quote.errors.any? %>
    <ul>
      <% quote.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form.text_field :name,
        placeholder: t("quotes.form.name_placeholder"),
        data: { action: "keydown.esc->inline-form#cancel" } %>
  <%= form.submit t("quotes.form.submit") %>
  <button type="button" data-action="click->inline-form#cancel"><%= t("quotes.form.cancel") %></button>
<% end %>
